rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // Nenhum documento do CRM pode ser lido ou alterado anonimamente.
    match /{document=**} {
      allow read, write: if false;
    }

    match /test/{docId} {
      allow read, write: if isSignedIn();
    }

    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    match /clientes/{clienteId} {
      allow read, write: if isSignedIn();
    }

    match /propostas/{propostaId} {
      allow read, write: if isSignedIn();
    }

    match /comissoesPromotoras/{comissaoId} {
      allow read, write: if isSignedIn();
    }

    match /contasPagar/{contaId} {
      allow read, write: if isSignedIn();
    }

    match /metas/{metaId} {
      allow read, write: if isSignedIn();
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if isSignedIn();
    }

    match /alertas/{alertaId} {
      allow read, write: if isSignedIn();
    }

    match /auditLogs/{logId} {
      allow read, write: if isSignedIn();
    }

    // Tokens e segredos de integração não devem ser persistidos no frontend.
    match /integrations/{serviceId} {
      allow read, write: if isSignedIn();
    }
  }
}
