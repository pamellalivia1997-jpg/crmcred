rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function to get current user data from users collection
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    
    function hasRole(role) {
      return isAuthenticated() && getUserData().role == role;
    }
    
    function isProprietaria() {
      return hasRole('proprietaria');
    }
    
    function isAdm() {
      return hasRole('adm') || isProprietaria();
    }
    
    function isFinanceiro() {
      return hasRole('financeiro') || isProprietaria();
    }
    
    function isVendedora() {
      return hasRole('vendedora') || isAdm();
    }

    // Regras de Usuários e Perfis
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow write: if isAdm();
    }

    // Regras de Clientes: Todas as vendedoras podem pesquisar e visualizar (sem restrição), mas apenas autenticadas
    match /clientes/{clienteId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdm();
    }

    // Regras de Propostas: Vendedoras podem ler todas, mas só editam as próprias
    match /propostas/{propostaId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAdm() || (isVendedora() && (resource.data.vendedora == getUserData().name || resource.data.digitador == getUserData().name));
      allow delete: if isProprietaria();
    }

    // Regras de Comissões de Promotoras: Apenas Financeiro e Proprietária
    match /comissoes_promotoras/{comissaoId} {
      allow read, write: if isFinanceiro();
    }

    // Regras de Contas a Pagar: Apenas Financeiro e Proprietária
    match /contas_pagar/{contaId} {
      allow read, write: if isFinanceiro();
    }

    // Regras de Metas: ADM e Proprietária gerenciam; Vendedoras lêem apenas as suas
    match /metas/{metaId} {
      allow read: if isAuthenticated();
      allow write: if isAdm();
    }

    // Regras de Feedbacks: ADM gerencia; Vendedora lê os seus
    match /feedbacks/{feedbackId} {
      allow read: if isAuthenticated();
      allow write: if isAdm();
    }

    // Regras de Alertas e Oportunidades
    match /alertas/{alertaId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    // Regras de Auditoria LGPD: Apenas leitura para ADM/Proprietária; escrita permitida para registro do log
    match /audit_logs/{logId} {
      allow read: if isAdm();
      allow create: if isAuthenticated();
      allow update, delete: if false; // Logs são imutáveis
    }
  }
}
