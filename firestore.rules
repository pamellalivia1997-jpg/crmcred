rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Permitir leitura e gravação para todas as coleções do CRM Lívia Cred Saúde
    // Permite que tanto o ambiente do Studio quanto acessos externos (como GitHub Pages e celulares)
    // sincronizem os dados da nuvem em tempo real sem bloqueio de autenticação prévia.
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
