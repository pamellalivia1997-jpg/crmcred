rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unmapped paths
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isManager() {
      return isSignedIn() && (
        request.auth.token.email == 'pamellalivia1997@gmail.com' ||
        request.auth.token.email == 'livia@liviacredsaude.com.br' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['proprietaria', 'adm', 'financeiro'])
      );
    }

    // Test connection document
    match /test/{docId} {
      allow read, write: if true;
    }

    // Usuários do Sistema
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Carteira de Clientes
    match /clientes/{clienteId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Propostas de Crédito
    match /propostas/{propostaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Comissões das Promotoras (Dados Financeiros Sensíveis)
    match /comissoesPromotoras/{comissaoId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Contas a Pagar / Despesas (Dados Financeiros Sensíveis)
    match /contasPagar/{contaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Metas Comerciais
    match /metas/{metaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Feedbacks Internos
    match /feedbacks/{feedbackId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Alertas de Oportunidades
    match /alertas/{alertaId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn();
    }

    // Trilha de Auditoria LGPD
    match /auditLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isManager();
    }
  }
}
