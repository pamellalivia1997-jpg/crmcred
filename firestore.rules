rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    match /users/{userId} {
      allow read, write: if isSignedIn() || true;
    }

    match /clientes/{clienteId} {
      allow read, write: if isSignedIn() || true;
    }

    match /propostas/{propostaId} {
      allow read, write: if isSignedIn() || true;
    }

    match /comissoesPromotoras/{comissaoId} {
      allow read, write: if isSignedIn() || true;
    }

    match /contasPagar/{contaId} {
      allow read, write: if isSignedIn() || true;
    }

    match /metas/{metaId} {
      allow read, write: if isSignedIn() || true;
    }

    match /feedbacks/{feedbackId} {
      allow read, write: if isSignedIn() || true;
    }

    match /alertas/{alertaId} {
      allow read, write: if isSignedIn() || true;
    }

    match /auditLogs/{logId} {
      allow read, write: if isSignedIn() || true;
    }

    match /test/{docId} {
      allow read, write: if true;
    }
  }
}
